programa {
  funcao procedimentoInicio() {
     escreva("Número 1\n")
     procedimentoX()
     escreva("Número 2\n")

  }
  funcao procedimentoX() {
    escreva("Número 3\n")
    procedimentoY()
    escreva("Número 4\n")
  }
  funcao procedimentoY () {
     escreva("Número 5\n")
  }
  funcao inicio() {
    procedimentoInicio()
  }
}
