programa {
  funcao procedimentoInicio() {
      escreva("Inicio\n")
      procedimentoA()
      escreva("Fim\n")
  }
  funcao procedimentoA() {
      escreva("Número 1\n")
      procedimentoB()
      escreva("Número 2\n")
  }
  funcao procedimentoB() {
      escreva("Número 3\n")
      procedimentoC()
      escreva("Número 4\n")
  }
  funcao procedimentoC() {
      escreva("Número 5\n")
  }
  funcao inicio() {
    procedimentoInicio()
  }
}
